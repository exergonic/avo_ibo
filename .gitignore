# pixi environments
.pixi/*
!.pixi/config.toml

# Python cache
__pycache__/
*.pyc
.pytest_cache/

# Debug log
debug_log/
_last_output.json

# Psi4 artifacts
timer.dat
log.txt
NUL.log
psi.*

# Temporary test scripts
_test_*.py
test_molden.log

# Build artifacts
*.egg-info/
*.pdf

# calcs/ runtime artifacts (but keep .gitkeep so directory ships with repo)
calcs/*
!calcs/.gitkeep

# Not shipped to Avogadro users (internal docs, examples, derivations)
CONTINUITY.md
examples/
mathematics/
paper/
ROADMAP.md
TROUBLESHOOTING.md
tutorial.md

# Editor/IDE files
.vscode/

# Reference schemas (local copies)
cjson.scheme
plugin_spec.md
PLUGIN-SPEC.md

# local markdown files
_*.md
